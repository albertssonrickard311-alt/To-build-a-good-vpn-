<Window
    x:Class="VeytrixVPN.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Veytrix VPN"
    Width="1100"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    Background="{StaticResource BackgroundBrush}"
    Foreground="{StaticResource TextBrush}">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <DockPanel>

            <Button
                DockPanel.Dock="Right"
                Content="ABOUT"
                Width="90"
                VerticalAlignment="Center"
                Click="About_Click"/>

            <StackPanel>

                <TextBlock
                    Text="Veytrix VPN"
                    FontSize="32"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="Secure WireGuard VPN Client"
                    Foreground="{StaticResource MutedBrush}"
                    Margin="0,4,0,0"/>

            </StackPanel>

        </DockPanel>

        <!-- TOOLBAR -->

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,25,0,15">

            <TextBox
                x:Name="SearchBox"
                Width="280"
                Height="38"
                Padding="10"
                TextChanged="SearchBox_TextChanged"/>

            <Button
                Content="AUTO SELECT"
                Width="130"
                Click="AutoSelect_Click"/>

            <Button
                Content="PING SERVERS"
                Width="130"
                Click="PingServers_Click"/>

        </StackPanel>

        <!-- MAIN -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- SERVERS -->

            <Border
                Background="{StaticResource PanelBrush}"
                CornerRadius="10"
                Padding="10">

                <ListView
                    x:Name="ServerList"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource TextBrush}"
                    SelectionChanged="ServerList_SelectionChanged">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Background="{StaticResource Panel2Brush}"
                                CornerRadius="7"
                                Padding="14"
                                Margin="4">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="100"/>

                                        <ColumnDefinition Width="100"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontWeight="Bold"
                                            FontSize="16"/>

                                        <TextBlock
                                            Text="{Binding Hostname}"
                                            Foreground="{StaticResource MutedBrush}"
                                            Margin="0,3,0,0"/>

                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding PingText}"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding LoadText}"
                                        VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Border>

            <!-- CONNECTION PANEL -->

            <Border
                Grid.Column="1"
                Background="{StaticResource PanelBrush}"
                CornerRadius="10"
                Padding="25"
                Margin="18,0,0,0">

                <StackPanel>

                    <TextBlock
                        Text="VPN CONNECTION"
                        FontSize="20"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="ConnectionStatus"
                        Text="Disconnected"
                        FontSize="16"
                        Foreground="{StaticResource MutedBrush}"
                        Margin="0,10,0,25"/>

                    <Button
                        x:Name="ConnectButton"
                        Content="CONNECT"
                        Height="55"
                        FontSize="18"
                        Click="ConnectButton_Click"/>

                    <Separator Margin="0,25"/>

                    <TextBlock
                        Text="Selected server"
                        Foreground="{StaticResource MutedBrush}"/>

                    <TextBlock
                        x:Name="SelectedServerText"
                        Text="No server selected"
                        FontSize="16"
                        Margin="0,5,0,15"
                        TextWrapping="Wrap"/>

                    <CheckBox
                        x:Name="AdBlockCheckBox"
                        Content="Ad blocker"
                        IsChecked="True"
                        Margin="0,6"/>

                    <CheckBox
                        x:Name="TrackerCheckBox"
                        Content="Tracker blocker"
                        IsChecked="True"
                        Margin="0,6"/>

                    <CheckBox
                        x:Name="AutoReconnectCheckBox"
                        Content="Auto reconnect"
                        IsChecked="True"
                        Margin="0,6"/>

                    <CheckBox
                        x:Name="KillSwitchCheckBox"
                        Content="Kill switch"
                        IsChecked="True"
                        Margin="0,6"/>

                    <CheckBox
                        x:Name="IPv6CheckBox"
                        Content="IPv4 + IPv6"
                        IsChecked="True"
                        Margin="0,6"/>

                    <Separator Margin="0,20"/>

                    <TextBlock
                        x:Name="RuleCountText"
                        Text="Blocklists: loading..."
                        Foreground="{StaticResource MutedBrush}"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- FOOTER -->

        <StatusBar
            Grid.Row="3"
            Margin="0,15,0,0">

            <TextBlock
                x:Name="StatusText"
                Text="Ready"/>

        </StatusBar>

    </Grid>

</Window>
