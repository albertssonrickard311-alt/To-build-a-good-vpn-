<Application x:Class="VeytrixVPN.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0F14"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#111821"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#1C2430"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#263241"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8D99A8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8D99A8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#35D07F"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E05252"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#18212C"/>
            <Setter Property="BorderBrush" Value="#2B3948"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#151D27"/>
            <Setter Property="BorderBrush" Value="#2B3948"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

    </Application.Resources>

</Application>
